#!/bin/bash
# Instalador de Cerebro-Miniaturas: crea ~/Cerebro-Miniaturas listo para usar en Claude Code.
set -e
DEST="$HOME/Cerebro-Miniaturas"
TMP="$(mktemp -d)"
echo "Instalando Cerebro-Miniaturas en $DEST ..."
echo '' | base64 -d | tar -xzf - -C "$TMP"
mkdir -p "$DEST/proyectos"
if [ -f "$DEST/historial.md" ]; then
  cp "$DEST/historial.md" "$TMP/.historial.bak"
  cp -R "$TMP/." "$DEST/"
  mv "$TMP/.historial.bak" "$DEST/historial.md"
  rm -f "$DEST/.historial.bak"
  echo "Actualizado (se conservaron historial.md, .env y proyectos/)."
else
  cp -R "$TMP/." "$DEST/"
fi
rm -rf "$TMP"

if ! grep -qs '^OPENAI_API_KEY=.\+' "$DEST/.env"; then
  echo ""
  echo "Pega tu OpenAI API key (platform.openai.com > API keys) y Enter. No se va a ver mientras la pegas:"
  read -rs KEY
  cp "$DEST/.env.example" "$DEST/.env"
  sed -i '' "s|^OPENAI_API_KEY=.*|OPENAI_API_KEY=$KEY|" "$DEST/.env" 2>/dev/null || sed -i "s|^OPENAI_API_KEY=.*|OPENAI_API_KEY=$KEY|" "$DEST/.env"
  echo "Key guardada en $DEST/.env"
fi

if command -v node >/dev/null 2>&1; then
  echo "Node $(node -v) OK"
else
  echo "Falta Node.js (version 18 o superior). Instalalo desde https://nodejs.org y listo."
fi

echo ""
echo "Listo. En la app de Claude: tocá + > elegí la carpeta Cerebro-Miniaturas > escribí /miniatura"
open "$DEST" 2>/dev/null || true
